<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteRule ^ - [E=VH_BUCKET:%{TIME_YEAR}%{TIME_MON}%{TIME_DAY}-%{TIME_HOUR}]

    RewriteRule ^runtime/ - [F,L]

    RewriteRule ^templates/.*\.(php|json)$ - [F,L]

    RewriteCond %{REQUEST_METHOD} =GET
    RewriteCond %{DOCUMENT_ROOT}/c/.lock !-f
    RewriteCond %{DOCUMENT_ROOT}/c/%{TIME_YEAR}%{TIME_MON}%{TIME_DAY}-%{TIME_HOUR}/index.html -f
    RewriteRule ^index\.php$ c/%{TIME_YEAR}%{TIME_MON}%{TIME_DAY}-%{TIME_HOUR}/index.html [L]

    RewriteCond %{REQUEST_METHOD} =GET
    RewriteCond %{QUERY_STRING} ^source=(\d+)$
    RewriteCond %{DOCUMENT_ROOT}/c/.lock !-f
    RewriteCond %{DOCUMENT_ROOT}/c/%{TIME_YEAR}%{TIME_MON}%{TIME_DAY}-%{TIME_HOUR}/index-%1.html -f
    RewriteRule ^index\.php$ c/%{TIME_YEAR}%{TIME_MON}%{TIME_DAY}-%{TIME_HOUR}/index-%1.html [L]

    RewriteCond %{REQUEST_METHOD} =GET
    RewriteCond %{QUERY_STRING} ^source=(\d+)&type=(\d+)&page=(\d+)$
    RewriteCond %{DOCUMENT_ROOT}/c/.lock !-f
    RewriteCond %{DOCUMENT_ROOT}/c/%{TIME_YEAR}%{TIME_MON}%{TIME_DAY}-%{TIME_HOUR}/list-%1-%2-%3.html -f
    RewriteRule ^list\.php$ c/%{TIME_YEAR}%{TIME_MON}%{TIME_DAY}-%{TIME_HOUR}/list-%1-%2-%3.html [L]

    RewriteCond %{REQUEST_METHOD} =GET
    RewriteCond %{QUERY_STRING} ^source=(\d+)&type=(\d+)$
    RewriteCond %{DOCUMENT_ROOT}/c/.lock !-f
    RewriteCond %{DOCUMENT_ROOT}/c/%{TIME_YEAR}%{TIME_MON}%{TIME_DAY}-%{TIME_HOUR}/list-%1-%2-1.html -f
    RewriteRule ^list\.php$ c/%{TIME_YEAR}%{TIME_MON}%{TIME_DAY}-%{TIME_HOUR}/list-%1-%2-1.html [L]

    RewriteCond %{REQUEST_METHOD} =GET
    RewriteCond %{QUERY_STRING} ^source=(\d+)&id=(\d+)$
    RewriteCond %{DOCUMENT_ROOT}/c/.lock !-f
    RewriteCond %{DOCUMENT_ROOT}/c/%{TIME_YEAR}%{TIME_MON}%{TIME_DAY}-%{TIME_HOUR}/play-%1-%2.html -f
    RewriteRule ^play\.php$ c/%{TIME_YEAR}%{TIME_MON}%{TIME_DAY}-%{TIME_HOUR}/play-%1-%2.html [L]

    RewriteCond %{REQUEST_METHOD} =GET
    RewriteCond %{DOCUMENT_ROOT}/c/.lock !-f
    RewriteCond %{DOCUMENT_ROOT}/c/%{TIME_YEAR}%{TIME_MON}%{TIME_DAY}-%{TIME_HOUR}/history.html -f
    RewriteRule ^history\.php$ c/%{TIME_YEAR}%{TIME_MON}%{TIME_DAY}-%{TIME_HOUR}/history.html [L]

    RewriteCond %{REQUEST_METHOD} =GET
    RewriteCond %{QUERY_STRING} ^source=(\d+)$
    RewriteCond %{DOCUMENT_ROOT}/c/.lock !-f
    RewriteCond %{DOCUMENT_ROOT}/c/%{TIME_YEAR}%{TIME_MON}%{TIME_DAY}-%{TIME_HOUR}/history-%1.html -f
    RewriteRule ^history\.php$ c/%{TIME_YEAR}%{TIME_MON}%{TIME_DAY}-%{TIME_HOUR}/history-%1.html [L]
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
    <!-- 图片加 nosniff（1.3.4）：img.php 自己已经在发了，但**静态直出**的那批
         （imgcache 命中后的 c/ 与 static/ 下的副本）没有。
         没有 nosniff 时浏览器会猜 MIME，猜错就可能把图片当 HTML 解析。 -->
    <FilesMatch "\.(jpg|jpeg|png|gif|svg|webp|avif|bmp|ico|woff|woff2)$">
        Header set Cache-Control "public, max-age=2592000"
        Header set X-Content-Type-Options "nosniff"
    </FilesMatch>
    <FilesMatch "\.php$">
        Header setifempty Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>
