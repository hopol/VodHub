# 影视聚合站 Apache 配置
# 覆盖：访问控制 + 静态资源缓存

# ============================================================
# 一、访问控制
# ============================================================
<IfModule mod_rewrite.c>
    RewriteEngine On
    # 运行时数据（数据库、缓存）禁止直接访问
    RewriteRule ^runtime/ - [F,L]
    # 模板文件只应由程序 include，禁止直接通过 URL 访问
    RewriteRule ^templates/.*\.(php|json)$ - [F,L]
</IfModule>

# ============================================================
# 二、静态资源缓存（免费虚拟空间方案）
#
# 免费空间通常只有 Apache、无法改 Nginx 配置，只能靠 .htaccess。
# 需要 mod_expires（Apache 2.4+ 默认启用）与 mod_headers。
# 若空间禁用了这两个模块，下面的 <IfModule> 会自动跳过，不会报 500。
# ============================================================
<IfModule mod_expires.c>
    ExpiresActive On

    # CSS / JS：改动不频繁，缓存 7 天
    ExpiresByType text/css              "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"

    # 图片：几乎不变，缓存 30 天
    ExpiresByType image/jpeg            "access plus 30 days"
    ExpiresByType image/png             "access plus 30 days"
    ExpiresByType image/gif             "access plus 30 days"
    ExpiresByType image/svg+xml         "access plus 30 days"
    ExpiresByType image/webp            "access plus 30 days"
    ExpiresByType image/x-icon          "access plus 30 days"
    ExpiresByType font/woff2            "access plus 30 days"
    ExpiresByType font/woff             "access plus 30 days"

    # HTML 动态页面不缓存（PHP 输出的页面必须实时）
    ExpiresByType text/html             "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    # 给静态资源加 Cache-Control（与 Expires 一起，覆盖更多浏览器）
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
    <FilesMatch "\.(jpg|jpeg|png|gif|svg|webp|ico|woff|woff2)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    <FilesMatch "\.php$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>
